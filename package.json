{
  "name": "tan-servora",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "build": "vite build && cp instrument.server.mjs dist/server",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.*'",
    "test:integration": "dotenv -e .env.local -- vitest run integration.test",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "start": "node --import ./dist/server/instrument.server.mjs dist/server/server.js",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv -e .env.local -- zen generate --lite",
		"db:push": "dotenv -e .env.local -- zen db push && dotenv -e .env.local -- node scripts/ensure-auth-session-role-sync.mjs",
    "db:migrate": "dotenv -e .env.local -- zen migrate dev",
    "db:studio": "dotenv -e .env.local -- zen studio",
		"db:seed": "dotenv -e .env.local -- tsx src/server/seed.ts && dotenv -e .env.local -- node scripts/ensure-auth-session-role-sync.mjs",
		"auth:migrate": "dotenv -e .env.local -- pnpm dlx @better-auth/cli@1.4.22 migrate --config src/lib/auth/server.ts && dotenv -e .env.local -- node scripts/ensure-auth-session-role-sync.mjs",
    "ba:shadow": "dotenv -e .env.local -- pnpm dlx @better-auth/cli@1.4.22 generate --config src/lib/auth/codegen.ts --output zenstack/_ba-raw.prisma -y && node scripts/ba-shadow.mjs",
    "email:dev": "email dev --dir ./src/emails",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale"
  },
  "dependencies": {
    "@better-auth-ui/core": "1.6.3",
    "@better-auth-ui/react": "1.6.3",
    "@better-auth/passkey": "^1.6.15",
    "@faker-js/faker": "^10.4.0",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@orpc/client": "^1.14.5",
    "@orpc/json-schema": "^1.14.5",
    "@orpc/openapi": "^1.14.5",
    "@orpc/server": "^1.14.5",
    "@orpc/tanstack-query": "^1.14.5",
    "@orpc/zod": "^1.14.5",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sentry/tanstackstart-react": "^10.56.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.168.18",
    "@tanstack/store": "latest",
    "@zenstackhq/orm": "^3.7.2",
    "@zenstackhq/plugin-policy": "^3.7.2",
    "@zenstackhq/schema": "^3.7.2",
    "@zenstackhq/server": "^3.7.2",
    "@zenstackhq/tanstack-query": "^3.7.2",
    "better-auth": "^1.6.15",
    "bowser": "^2.14.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "resend": "^6.12.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@inlang/paraglide-js": "^2.18.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@zenstackhq/cli": "^3.7.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "react-email": "^6.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
