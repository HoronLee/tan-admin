// Better Auth managed tables — auto-generated shadow declarations.
// Source of truth: src/lib/auth/config.ts. Regenerate via `pnpm ba:shadow`.
// All BA models in `_better-auth.zmodel` are @@ignore so ZenStack won't
// manage them — but their relations are visible to the policy engine.
import "_better-auth"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

/// Auth context injected per-request via authDb.$setAuth()
type Auth {
  userId                 String  @id
  isAdmin               Boolean?
  activeOrganizationId   String?
  activeOrganizationRole String?
  @@auth
}

/// Menu route metadata stored as JSONB (ZenStack typed JSON, PostgreSQL only)
type MenuMeta {
  title                    String?
  icon                     String?
  activeIcon               String?
  activePath               String?
  order                    Int?
  affixTab                 Boolean?
  affixTabOrder            Int?
  badge                    String?
  badgeType                String?
  badgeVariants            String?
  hideChildrenInMenu       Boolean?
  hideInBreadcrumb         Boolean?
  hideInMenu               Boolean?
  hideInTab                Boolean?
  iframeSrc                String?
  ignoreAccess             Boolean?
  keepAlive                Boolean?
  link                     String?
  maxNumOfOpenTab          Int?
  menuVisibleWithForbidden Boolean?
  openInNewWindow          Boolean?
}

/// Menu / Route tree node. meta is stored as typed JSONB.
model Menu {
  id                 Int       @id @default(autoincrement())
  type               String    @default("MENU")
  path               String?
  name               String?   @unique
  component          String?
  redirect           String?
  alias              String?
  meta               MenuMeta? @json
  parentId           Int?
  parent             Menu?     @relation("MenuTree", fields: [parentId], references: [id])
  children           Menu[]    @relation("MenuTree")
  status             String    @default("ACTIVE")
  order              Int       @default(0)
  /// Better Auth organization id (UUID). null = visible across all orgs.
  organizationId     String?
  /// Permission key required to view this menu node (format: "resource:action").
  /// null = any authenticated user can view.
  requiredPermission String?
  createdAt          DateTime  @default(now())

  @@deny('all', auth() == null)
  // Read isolation: global menus (organizationId == null) are visible to any
  // authenticated user; org-scoped menus only to members of that org.
  @@allow('read', auth() != null && (organizationId == null || organizationId == auth().activeOrganizationId))
  @@allow('all', auth().isAdmin == true)
  @@allow('create', auth().activeOrganizationRole == "owner" && organizationId == auth().activeOrganizationId)
  @@allow('update', auth().activeOrganizationRole == "owner" && organizationId == auth().activeOrganizationId)
  @@allow('delete', auth().activeOrganizationRole == "owner" && organizationId == auth().activeOrganizationId)
  // 'update' rules only see the PRE-update state, and 'all' does NOT expand to
  // post-update in ZenStack v3 — without the rules below an org owner could
  // re-scope a menu (organizationId -> null / another org) to escape the
  // write boundary. Admins may re-scope; owners must keep the org unchanged.
  @@allow('post-update', auth().isAdmin == true)
  @@allow('post-update', organizationId == auth().activeOrganizationId)
}
