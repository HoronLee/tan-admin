# Your Sentry DSN (from your Sentry account)
VITE_SENTRY_DSN=

# Your Sentry organization (from your Sentry account)
VITE_SENTRY_ORG=

# Your Sentry project (from your Sentry account)
VITE_SENTRY_PROJECT=

# Your Sentry authentication token (from your Sentry account)
SENTRY_AUTH_TOKEN=
# Database URL for PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres" # Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# Optional: bootstrap a super-admin account when `pnpm db:seed` runs.
# When both are set, the seed script creates the user via Better Auth (idempotent)
# and binds it to the `super-admin` role so policy-protected CRUD works out-of-the-box.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=admin@123

# === Product Mode ===
# 产品交付形态（不是物理多租户！底层始终是 BA organization 的 multi-workspace
# 模型，隔离由 ZenStack policy 在业务层兜底）。
#   private = 甲方交付 / 私有化部署：seed 默认组织 + 超管 owner，注册用户
#             自动入伙默认组织，禁止自建 org（`/organizations` 新建/解散灰掉）。
#   saas    = 公开 B2B SaaS workspace 模型（Slack / Notion / Linear 那种）：
#             任何人注册即可为自己 workspace 的 owner，可自建/解散。
#
# **前后端共用单份 VITE_ 前缀**（Node 进程也能 process.env.VITE_*）。
# 不再有独立的 server PRODUCT_MODE，消除 drift。
# 详见 .trellis/spec/backend/product-modes.md。
VITE_PRODUCT_MODE=private

# BA organization.teams 插件级开关写死为 true（产品支持 team 概念）；
# 具体某个 org 能否创建 team 由 organization.metadata.plan 决定（plan gating）。
# 不再通过 env flag 控制。详见 .trellis/spec/backend/plan-gating.md。

# === Seed defaults ===
# 仅在 PRODUCT_MODE=private 时用于 seed 创建默认组织
SEED_DEFAULT_ORG_NAME=默认组织
SEED_DEFAULT_ORG_SLUG=default

# === Email transport ===
# console=dev only log / smtp=国内生产首推 / resend=海外生产
# NODE_ENV=production 时禁止使用 console
EMAIL_TRANSPORT=console
EMAIL_FROM=noreply@localhost
# EMAIL_FROM_NAME 可选。不设时自动回退到 VITE_BRAND_NAME（brand 单一真相源）。
# 仅当发件人显示名和品牌名需要不一致时才单独设置
# (如 brand=Acme 但发件人想写 "Acme Security Alerts").
# EMAIL_FROM_NAME=
# Dev 便捷: APP_ENV=dev 时以 @dev.com 结尾的邮箱注册后自动 emailVerified=true,
# 不发验证邮件 (测试账号专用). prod 下无效.

# === SMTP (EMAIL_TRANSPORT=smtp 时用) ===
# SMTP_HOST 必填; SMTP_USER/SMTP_PASS 可选 (同时有或同时无).
# 本地测试 (mailpit/maildev/maildev 等无认证 relay): 不填 SMTP_USER/PASS.
# 生产 (阿里云邮件推送 / SendGrid / SES 等):
#   SMTP_HOST=smtpdm.aliyun.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=noreply@yourdomain.com
#   SMTP_PASS=<控制台生成的 SMTP 密码, 不是登录密码>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# === Resend (EMAIL_TRANSPORT=resend 时必填) ===
RESEND_API_KEY=

# === Brand（全站品牌文字 + logo） ===
# 全部可选；不设时回退 "Tan Servora"，邮件与网页无 logo 只显示品牌文字。
#
# **前后端共用单份 VITE_ 前缀**：UI (`<BrandMark>`)、邮件 (`appConfig.brand`)、
# 发件人名 (EMAIL_FROM_NAME 默认值)、页面 title 全部读这里，改一处全联动。
#
# logoURL 暗色策略：只设 LOGO_URL 时 light/dark 共用同一张；另设 LOGO_DARK_URL
# 时 BA UI 模板按 prefers-color-scheme 自动切换（见 src/lib/email.tsx 的
# buildBrandProps + src/components/brand-mark.tsx）。
VITE_BRAND_NAME=
VITE_BRAND_LOGO_URL=
VITE_BRAND_LOGO_DARK_URL=

# === Brand color（仅服务端读，无 VITE_）===
# OKLCH 三元组裸值 "L C H"（不带 oklch() 包裹）。取色：
#   - https://oklch.com（OKLCH picker）
#   - https://tweakcn.com（导出 shadcn primary token，复制 :root --primary 那行的值）
#
# 不设 = 走 shadcn neutral 默认（light=oklch(0.205 0 0) 近黑 / dark=oklch(0.922 0 0)
# 近白），UI 与现状零偏差，邮件输出 hex `#171717` / `#e5e5e5` 与
# `email-styles.tsx#defaultColors` 字面对齐——非破坏性。
#
# 影响范围（Approach A 边界）：只动 --primary / --primary-foreground /
# --sidebar-primary / --sidebar-primary-foreground 共 4 个 shadcn token + 邮件按钮 hex。
# focus ring / chart / destructive / muted 保持中性灰。
#
# 例：BRAND_PRIMARY_OKLCH="0.55 0.18 264"  # 蓝紫（Linear 系）
BRAND_PRIMARY_OKLCH=

# 显式定调 dark 主色（同 OKLCH 三元组格式）。
# 不设时缺省优先级（"显式 > default > 派生" 见 config.server.ts）：
#   - BRAND_PRIMARY_OKLCH 已设 → culori 算法派生（L 反转 clamp[0.55,0.85] + chroma×0.85）
#   - 都未设 → 用 shadcn neutral 默认 oklch(0.922 0 0)
BRAND_PRIMARY_DARK_OKLCH=
